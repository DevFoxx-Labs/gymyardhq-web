# Server-only values (never prefix with NEXT_PUBLIC_). Read by config/site.ts at build time.
# Leave a value empty to show a highlighted "[… — to be confirmed]" placeholder.

# Public URL of this website, no trailing slash (used for canonical URLs, sitemap, OG images)
SITE_URL=

# Show the live "Get it on Google Play" link. Fails closed: only the exact value "true" enables it.
PLAY_STORE_LIVE=false

# Legal entity — used in every notice
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
SUPPORT_EMAIL=

# Grievance Officer (DPDP Act)
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_ACK_WITHIN=48 hours
GRIEVANCE_RESOLVE_WITHIN=30 days

# Terms / Privacy facts
JURISDICTION_CITY=
WEBSITE_HOSTING_PROVIDER=
EMAIL_PROVIDER=
RETENTION_SUPPORT_EMAILS=3 years after the request is closed
RETENTION_SERVER_LOGS=30 days
