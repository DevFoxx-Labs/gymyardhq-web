# Server-only values (never prefix with NEXT_PUBLIC_). Read by config/site.ts at build time.
# Leave a value empty to show a highlighted "[… — to be confirmed]" placeholder.

# REQUIRED for production builds (build fails without it): public origin, no trailing slash.
# Used for canonical URLs, og:url, sitemap, robots, JSON-LD and llms.txt.
SITE_URL=

# Show the live "Get it on Google Play" link. Fails closed: only the exact value "true" enables it.
PLAY_STORE_LIVE=false

# Legal entity — used in every notice
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
SUPPORT_EMAIL=

# Grievance Officer (DPDP Act)
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_ACK_WITHIN=48 hours
GRIEVANCE_RESOLVE_WITHIN=30 days

# Terms / Privacy facts
JURISDICTION_CITY=
WEBSITE_HOSTING_PROVIDER=
EMAIL_PROVIDER=
RETENTION_SUPPORT_EMAILS=3 years after the request is closed
RETENTION_SERVER_LOGS=30 days

# WhatsApp chat widget (bottom-right on every page + card on /contact).
# Fails closed: shown only when WHATSAPP_WIDGET_LIVE is exactly "true". When on, the build fails
# if the number or hours are malformed. The number is public (it is a contact channel).
WHATSAPP_WIDGET_LIVE=false
# Country code + number, digits only (spaces, + and - are stripped), e.g. 919876543210
WHATSAPP_NUMBER=
# Optional business hours in IST, "HH:MM-HH:MM". Empty = no online/away status is shown.
WHATSAPP_HOURS=
# Optional ISO weekdays for those hours: 1 = Monday … 7 = Sunday, e.g. "1-6" or "1,2,3,4,5". Default 1-7.
WHATSAPP_DAYS=
